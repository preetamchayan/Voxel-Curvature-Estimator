            if (x != xmin && y != ymin && z != zmin && (isSurface(ivec3(x - 1, y - 1, z - 1), R, C, D) || (isSurface(ivec3(x, y - 1, z - 1), R, C, D) && isSurface(ivec3(x - 1, y - 1, z), R, C, D) && !isInterior(ivec3(x - 1, y - 1, z - 1), R, C, D)))) addNeighbor(voxel, ivec3(x - 1, y - 1, z - 1), 7, plane, neighbors, R, C);
            break;
        case 3:
            if (y != ymax && isSurface(ivec3(x, y + 1, z), R, C, D)) addNeighbor(voxel, ivec3(x, y + 1, z), 0, plane, neighbors, R, C);
            if (y != ymin && isSurface(ivec3(x, y - 1, z), R, C, D)) addNeighbor(voxel, ivec3(x, y - 1, z), 1, plane, neighbors, R, C);

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer Voxels { uint data[]; } voxelsBuf;
layout(std430, binding = 1) buffer Curvatures { int data[]; } curvaturesBuf;
layout(std430, binding = 2) buffer SurfaceVoxelIds { int data[]; } surfaceIdsBuf;

// Ten 3-bit voxel states per uint; the top two bits are unused.
const uint VOXELS_PER_WORD = 10u;
const uint VOXEL_BITS = 3u;
const uint VOXEL_MASK = 0x7u;

uint loadVoxel(int voxelID) {
    const uint index = uint(voxelID);
    return (voxelsBuf.data[index / VOXELS_PER_WORD] >>
            ((index % VOXELS_PER_WORD) * VOXEL_BITS)) & VOXEL_MASK;
}

// Atomic CAS preserves neighboring packed voxels when separate invocations update
// different fields that share a uint.
void storeVoxel(int voxelID, uint value) {
    const uint index = uint(voxelID);
    const uint wordIndex = index / VOXELS_PER_WORD;
    const uint shift = (index % VOXELS_PER_WORD) * VOXEL_BITS;
    const uint mask = VOXEL_MASK << shift;
    uint expected = voxelsBuf.data[wordIndex];
    for (;;) {
        const uint replacement = (expected & ~mask) | ((value & VOXEL_MASK) << shift);
        const uint observed = atomicCompSwap(voxelsBuf.data[wordIndex], expected, replacement);
        if (observed == expected) return;
        expected = observed;
    }
}

layout(push_constant) uniform PushConstants { int operation; int width; int height; int depth; int plane; int curveLength; int surfaceVoxelCount; int padding; } pc;

const int INT_MAX_VALUE = 2147483647;
const int INT_MIN_VALUE = (-2147483647 - 1);
const int INVALID_CHAIN_CODE = 255;
const int INVALID_VOXEL_ID = -1;

struct Candidate {
    int voxelID;
    int chainCode;
};

// Private per-invocation curve buffer. Keeping this out of function parameters
// avoids glslang-generated array copies at call sites.
int gCurve3D[2 * 32 + 1];

int getVoxelID(ivec3 point, int R, int C) {
    return point.x + point.y * R + point.z * R * C;
}

ivec3 getCoordinates(int voxelID, int R, int C) {
    int t = voxelID % (R * C);
    return ivec3(t % R, t / R, voxelID / (R * C));
}

bool inGrid(int x, int y, int z, int R, int C, int D) {
    return x >= 0 && x < R && y >= 0 && y < C && z >= 0 && z < D;
}

bool pointEqual(ivec3 a, ivec3 b) {
    return a.x == b.x && a.y == b.y && a.z == b.z;
}

void setInvalidCandidate(inout Candidate c) {
    c.voxelID = INVALID_VOXEL_ID;
    c.chainCode = INVALID_CHAIN_CODE;
}

bool isInvalidCandidate(Candidate c) {
    return c.chainCode == INVALID_CHAIN_CODE || c.voxelID == INVALID_VOXEL_ID;
}

bool isSurface(ivec3 point, int R, int C, int D) {
    return inGrid(point.x, point.y, point.z, R, C, D) &&
           loadVoxel(getVoxelID(point, R, C)) == 1u;
}

bool isInterior(ivec3 point, int R, int C, int D) {
    return inGrid(point.x, point.y, point.z, R, C, D) &&
           loadVoxel(getVoxelID(point, R, C)) == 2u;
}

int getChainCode(ivec2 neighbor, ivec2 voxel) {
    const ivec2 dir = neighbor - voxel;
    if (dir.x == 1 && dir.y == 0) return 0;
    if (dir.x == 1 && dir.y == 1) return 1;
    if (dir.x == 0 && dir.y == 1) return 2;
    if (dir.x == -1 && dir.y == 1) return 3;
    if (dir.x == -1 && dir.y == 0) return 4;
    if (dir.x == -1 && dir.y == -1) return 5;
    if (dir.x == 0 && dir.y == -1) return 6;
    if (dir.x == 1 && dir.y == -1) return 7;
    return INVALID_CHAIN_CODE;
}

void addNeighbor(ivec3 voxel, ivec3 neighbor, int neighborIndex, int plane, inout Candidate neighbors[8], int R, int C) {
    neighbors[neighborIndex].voxelID = getVoxelID(neighbor, R, C);
    switch (plane / 3) {
        case 0:
            neighbors[neighborIndex].chainCode = getChainCode(ivec2(neighbor.x, neighbor.y), ivec2(voxel.x, voxel.y));
            break;
        case 1:
            neighbors[neighborIndex].chainCode = getChainCode(ivec2(neighbor.y, neighbor.z), ivec2(voxel.y, voxel.z));
            break;
        case 2:
            neighbors[neighborIndex].chainCode = getChainCode(ivec2(neighbor.z, neighbor.x), ivec2(voxel.z, voxel.x));
            break;
    }
}

void getNeighborsInPlane(ivec3 voxel, int plane, int R, int C, int D, out Candidate neighbors[8]) {
    for (int n = 0; n < 8; ++n) {
        setInvalidCandidate(neighbors[n]);
    }

    const int x = voxel.x;
    const int y = voxel.y;
    const int z = voxel.z;
    const int xmin = 0, xmax = R - 1;
    const int ymin = 0, ymax = C - 1;
    const int zmin = 0, zmax = D - 1;

    switch (plane) {
        case 0:
            if (x != xmax && isSurface(ivec3(x + 1, y, z), R, C, D)) addNeighbor(voxel, ivec3(x + 1, y, z), 0, plane, neighbors, R, C);
            if (x != xmin && isSurface(ivec3(x - 1, y, z), R, C, D)) addNeighbor(voxel, ivec3(x - 1, y, z), 1, plane, neighbors, R, C);
            if (y != ymax && isSurface(ivec3(x, y + 1, z), R, C, D)) addNeighbor(voxel, ivec3(x, y + 1, z), 2, plane, neighbors, R, C);
            if (y != ymin && isSurface(ivec3(x, y - 1, z), R, C, D)) addNeighbor(voxel, ivec3(x, y - 1, z), 3, plane, neighbors, R, C);
            if (x != xmax && y != ymax && isSurface(ivec3(x + 1, y + 1, z), R, C, D)) addNeighbor(voxel, ivec3(x + 1, y + 1, z), 4, plane, neighbors, R, C);
            if (x != xmax && y != ymin && isSurface(ivec3(x + 1, y - 1, z), R, C, D)) addNeighbor(voxel, ivec3(x + 1, y - 1, z), 5, plane, neighbors, R, C);
            if (x != xmin && y != ymax && isSurface(ivec3(x - 1, y + 1, z), R, C, D)) addNeighbor(voxel, ivec3(x - 1, y + 1, z), 6, plane, neighbors, R, C);
            if (x != xmin && y != ymin && isSurface(ivec3(x - 1, y - 1, z), R, C, D)) addNeighbor(voxel, ivec3(x - 1, y - 1, z), 7, plane, neighbors, R, C);
            break;
        case 1:
            if (y != ymax && (isSurface(ivec3(x, y + 1, z), R, C, D) || ((x != xmin && isSurface(ivec3(x - 1, y + 1, z), R, C, D)) || (x != xmax && isSurface(ivec3(x + 1, y + 1, z), R, C, D))) && ((z != zmin && isSurface(ivec3(x, y + 1, z - 1), R, C, D)) || (z != zmax && isSurface(ivec3(x, y + 1, z + 1), R, C, D))) && !isInterior(ivec3(x, y + 1, z), R, C, D))) addNeighbor(voxel, ivec3(x, y + 1, z), 0, plane, neighbors, R, C);

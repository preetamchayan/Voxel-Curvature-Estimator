            if (x != xmin && z != zmax && isSurface(ivec3(x - 1, y, z + 1), R, C, D)) addNeighbor(voxel, ivec3(x - 1, y, z + 1), 3, plane, neighbors, R, C);
            if (x != xmax && y != ymax && z != zmin && (isSurface(ivec3(x + 1, y + 1, z - 1), R, C, D) || (isSurface(ivec3(x, y + 1, z - 1), R, C, D) && isSurface(ivec3(x + 1, y + 1, z), R, C, D) && !isInterior(ivec3(x + 1, y + 1, z - 1), R, C, D)))) addNeighbor(voxel, ivec3(x + 1, y + 1, z - 1), 4, plane, neighbors, R, C);

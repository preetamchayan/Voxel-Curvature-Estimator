{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\windowsApp.exe",
      "args": [
        "assets\\armadillo.obj",
        "output\\armadillo_voxelized.obj",
        "output\\armadillo_curvature.obj"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "build (debug - Windows)"
    },

    {
      "name": "Release (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\windowsApp.exe",
      "args": [
        "assets\\armadillo.obj",
        "output\\armadillo_voxelized.obj",
        "output\\armadillo_curvature.obj",
        "output\\armadillo_curvature.mtl"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "build (release - Windows)"
    },

    {
      "name": "Debug (Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/linuxApp",
      "args": [
        "assets/armadillo.obj",
        "output/armadillo_voxelized.obj",
        "output/armadillo_curvature.obj"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build (debug - Linux)"
    },

    {
      "name": "Release (Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/linuxApp",
      "args": [
        "assets/armadillo.obj",
        "output/armadillo_voxelized.obj",
        "output/armadillo_curvature.obj"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,

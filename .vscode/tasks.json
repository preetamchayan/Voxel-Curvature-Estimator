{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (debug)",
      "dependsOn": ["compile shader"],
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-Wall",
        "-O0",
        "-g",
        "main.cpp",
        "Helper/OcTree/OcTree.cpp",
        "Helper/MeshLoader/MeshLoader.cpp",
        "Helper/HelperFunctions.cpp",
        "Voxelizer/MeshVoxelizer.cpp",
        "Voxelizer/Serial/MeshVoxelizerSerialEnv.cpp",
        "Voxelizer/Serial/DSSCreator/DSSCreator.cpp",
        "Voxelizer/Serial/TriangleVoxelizer/TriangleVoxelizer.cpp",
        "Voxelizer/OpenCL/MeshVoxelizerOclEnv.cpp",
        "Voxelizer/DirectX/MeshVoxelizerDirectxEnv.cpp",
        "Voxelizer/Vulkan/MeshVoxelizerVulkanEnv.cpp",
        // "CurvatureEstimator/CurvatureEstimator.cpp",
        // "CurvatureEstimator/Serial/CurvatureEstimatorSerialEnv.cpp",
        // "CurvatureEstimator/Vulkan/CurvatureEstimatorVulkanEnv.cpp",
        // "CurvatureEstimator/OpenCL/CurvatureEstimatorOclEnv.cpp",
        // "CurvatureEstimator/DirectX/CurvatureEstimatorDirectxEnv.cpp",
        "-o",
        "voxelizer",
        "-lOpenCL",
        "-lvulkan"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },

    {
      "label": "build (serial-debug)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-Wall",
        "-O0",
        "-g",

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (debug)",
      "dependsOn": ["compile shader"],
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-Wall",
        "-O0",
        "-g",
        "main.cpp",
        "Helper/OcTree/OcTree.cpp",
        "Helper/MeshLoader/MeshLoader.cpp",
        "Voxelizer/Voxelizer.cpp",
        "Voxelizer/OpenCL/VoxelizerOclEnv.cpp",
        "Voxelizer/DirectX/VoxelizerDirectxEnv.cpp",
        "Voxelizer/Vulkan/VoxelizerVulkanEnv.cpp",
        "CurvatureEstimator/CurvatureEstimator.cpp",
        "CurvatureEstimator/Vulkan/CurvatureEstimatorVulkanEnv.cpp",
        "CurvatureEstimator/OpenCL/CurvatureEstimatorOclEnv.cpp",
        "CurvatureEstimator/DirectX/CurvatureEstimatorDirectxEnv.cpp",
        "-o",
        "voxelizer",
        "-lOpenCL",
        "-lvulkan"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },

    {
      "label": "compile shader",
      "type": "shell",
      "command": "glslangValidator",
      "args": [
        "-V",
        "Voxelizer/Vulkan/VoxelizerKernel.comp",
        "-o",
        "Voxelizer/Vulkan/VoxelizerKernel.spv"
      ],
      "problemMatcher": []
    },

    {
      "label": "build (release)",
      "dependsOn": ["compile shader"],
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-Wall",
        "-O2",
        "main.cpp",
        "Helper/OcTree/OcTree.cpp",
        "Helper/MeshLoader/MeshLoader.cpp",
        "Voxelizer/Voxelizer.cpp",
        "Voxelizer/OpenCL/VoxelizerOclEnv.cpp",
        "Voxelizer/DirectX/VoxelizerDirectxEnv.cpp",
        "Voxelizer/Vulkan/VoxelizerVulkanEnv.cpp",
        "CurvatureEstimator/CurvatureEstimator.cpp",
        "CurvatureEstimator/Vulkan/CurvatureEstimatorVulkanEnv.cpp",
        "CurvatureEstimator/OpenCL/CurvatureEstimatorOclEnv.cpp",
        "CurvatureEstimator/DirectX/CurvatureEstimatorDirectxEnv.cpp",
        "-o",
        "voxelizer",
        "-lOpenCL",
        "-lvulkan"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": "$gcc"
    },

    {
      "label": "compile voxelizer cuda env (debug)",
      "type": "shell",
      "command": "nvcc",
      "args": [
        "-ccbin",
        "g++",
        "-O0",
        "-g",
        "-c",
        "Voxelizer/Cuda/VoxelizerCudaEnv.cu",
        "-o",
        "Voxelizer/Cuda/VoxelizerCudaEnv.o",
        "-I/usr/local/cuda/include"
      ],
      "problemMatcher": []
    },

    {
      "label": "compile curvature estimator cuda env (debug)",
      "type": "shell",
      "command": "nvcc",
      "args": [
        "-ccbin",
        "g++",
        "-O0",
        "-g",
        "-c",
        "CurvatureEstimator/Cuda/CurvatureEstimatorCudaEnv.cu",
        "-o",
        "CurvatureEstimator/Cuda/CurvatureEstimatorCudaEnv.o",
        "-I/usr/local/cuda/include"
      ],
      "problemMatcher": []
    },

    {
      "label": "compile voxelizer cuda kernel (debug)",
      "type": "shell",
      "command": "nvcc",
      "args": [
        "-ccbin",
        "g++",
        "-O0",
        "-g",
        "-c",
        "Voxelizer/Cuda/VoxelizerKernel.cu",
        "-o",
        "Voxelizer/Cuda/VoxelizerKernel.o",
        "-I/usr/local/cuda/include"
      ],
      "problemMatcher": []
    },

    {
      "label": "compile curvature estimator cuda kernel (debug)",
      "type": "shell",
      "command": "nvcc",
      "args": [
        "-ccbin",
        "g++",
        "-O0",
        "-g",
        "-c",
        "CurvatureEstimator/Cuda/CurvatureEstimatorKernel.cu",
        "-o",
        "CurvatureEstimator/Cuda/CurvatureEstimatorKernel.o",
        "-I/usr/local/cuda/include"
      ],
      "problemMatcher": []
    },

    {
      "label": "build (debug - cuda)",
      "dependsOn": [
        "compile voxelizer cuda env (debug)",
        "compile curvture estimator cuda kernel (debug)",
        "compile voxelizer cuda kernel (debug)",
        "compile curvature estimator cuda env (debug)"
      ],
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-Wall",
        "-O0",
        "-g",
        "main.cpp",
        "Helper/OcTree/OcTree.cpp",
        "Helper/MeshLoader/MeshLoader.cpp",
        "Voxelizer/Voxelizer.cpp",
        "Voxelizer/OpenCL/VoxelizerOclEnv.cpp",
        "Voxelizer/DirectX/VoxelizerDirectxEnv.cpp",
        "Voxelizer/Vulkan/VoxelizerVulkanEnv.cpp",
        "Voxelizer/Cuda/VoxelizerCudaEnv.o",
        "Voxelizer/Cuda/VoxelizerKernel.o",
        "CurvatureEstimator/Cuda/CurvatureEstimatorCudaEnv.o",
        "CurvatureEstimator/Cuda/CurvatureEstimatorKernel.o",
        "-I/usr/local/cuda/include",
        "-o",
        "voxelizer",
        "-lOpenCL",
        "-lvulkan",
        "-L/usr/local/cuda/lib64",
        "-lcudart"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": "$gcc"
    },


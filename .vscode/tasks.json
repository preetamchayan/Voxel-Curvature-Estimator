        "Voxelizer/Serial/TriangleVoxelizer/TriangleVoxelizer.cpp",
        "-o",
        "voxelize"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },

    {
      "label": "compile shader",
      "type": "shell",
      "command": "glslangValidator",
      "args": [
        "-V",
        "Voxelizer/Vulkan/MeshVoxelizerKernel.comp",
        "-o",
        "Voxelizer/Vulkan/MeshVoxelizerKernel.spv"
      ],
      "problemMatcher": []
    },

